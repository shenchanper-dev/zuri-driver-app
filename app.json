{
  "expo": {
    "name": "ZURI Conductor",
    "slug": "zuri-driver-app",
    "version": "2.0.0-alpha.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zuridriver",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pe.zuri.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para asignarte servicios cercanos",
        "NSLocationAlwaysUsageDescription": "Tu ubicación se usa para tracking durante los servicios",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tu ubicación es necesaria para el servicio de transporte médico",
        "NSFaceIDUsageDescription": "Usa Face ID para iniciar sesión de forma segura",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSSpeechRecognitionUsageDescription": "ZURI usa reconocimiento de voz para ingresar texto manos libres.",
        "NSMicrophoneUsageDescription": "ZURI necesita el micrófono para reconocimiento de voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0066CC"
      },
      "package": "pe.zuri.conductor",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "ACTIVITY_RECOGNITION",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "redirects": [
            {
              "source": "/togu",
              "destination": "/login"
            }
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que ZURI acceda a tu ubicación para tracking de servicios",
          "locationWhenInUsePermission": "Tu ubicación se usa durante servicios activos",
          "locationAlwaysPermission": "Tu ubicación es necesaria para tracking",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usar Face ID para autenticación segura"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00875A",
          "defaultChannel": "servicios-urgentes",
          "sounds": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ZURI necesita el micrófono para reconocimiento de voz.",
          "speechRecognitionPermission": "ZURI usa reconocimiento de voz para ingresar texto manos libres."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "./plugins/withKotlinSkipMetadataCheck",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "router": {
        "origin": false,
        "redirects": [
          {
            "source": "/togu",
            "destination": "/login"
          },
          {
            "source": "/togu",
            "destination": "/login"
          }
        ]
      },
      "eas": {
        "projectId": "df9417e0-2cb9-4280-b4b3-9fe31c899d13"
      }
    },
    "owner": "baztonino",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0eae9dfa-a897-445d-89b0-9cdb74ea905c"
    }
  }
}
